{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/session",
      "destination": "/api/auth?session=1"
    },
    {
      "source": "/api/sample",
      "destination": "/api/receipt?sample=1"
    },
    {
      "source": "/api/telegram/setup",
      "destination": "/api/telegram?setup=1"
    },
    {
      "source": "/api/webhooks/:provider",
      "destination": "/api/pay?provider=:provider"
    },
    {
      "source": "/r/:token",
      "destination": "/r"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{fonts,db}/**",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 8 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/app",
      "permanent": false
    }
  ]
}
