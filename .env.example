# Required: signs every receipt link so nobody can make or change one. Any long random string.
SLIPP_SECRET=

# Optional: an access code the dashboard must send before it can make receipts.
SLIPP_KEY=

# Optional: automatic sending through Meta's WhatsApp Cloud API.
# Without these, Slipp opens WhatsApp with the receipt ready to send.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v21.0

# Optional: card payments that send their own receipts.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
# The business shown on receipts made from payment webhooks.
BUSINESS_NAME=
BUSINESS_PHONE=
BUSINESS_ADDRESS=
CURRENCY_SYMBOL=₦

# Optional: time zone for dates on PDF receipts (default Africa/Lagos).
TZ_RECEIPT=Africa/Lagos
