# Required: signs receipt links, dashboard sign-in links and connect codes. Any long random string.
SLIPP_SECRET=

# Required for the chat assistant: a Postgres database. On Vercel, connecting Supabase or Neon
# to the project adds POSTGRES_URL by itself; Slipp creates its tables on first start.
DATABASE_URL=
# Optional: Supabase's CA certificate, so the database certificate is checked.
DATABASE_CA_CERT=

# The AI. On Vercel nothing is needed: Slipp uses AI Gateway with the deployment's own sign-in.
# Elsewhere set one of these. SLIPP_MODEL picks the Claude model (default claude-opus-5-5).
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
SLIPP_MODEL=

# Telegram bot (from @BotFather). After deploying, open /api/telegram/setup once.
TELEGRAM_BOT_TOKEN=

# WhatsApp bot and automatic receipt sending (Meta WhatsApp Cloud API).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
GRAPH_API_VERSION=v21.0

# Daily reminders about due invoices (Vercel Cron sends this back as a bearer token).
CRON_SECRET=

# Optional: an access code the quick receipt maker (/app) must send before it can make receipts.
SLIPP_KEY=

# Optional: card payments that send their own receipts.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
# The business shown on receipts made from payment webhooks.
BUSINESS_NAME=
BUSINESS_PHONE=
BUSINESS_ADDRESS=
CURRENCY_SYMBOL=₦

# Optional: time zone for dates and reports (default Africa/Lagos), and the country code
# used to turn local numbers like 0803... into WhatsApp links (default 234).
TZ_RECEIPT=Africa/Lagos
DEFAULT_COUNTRY_CODE=234
